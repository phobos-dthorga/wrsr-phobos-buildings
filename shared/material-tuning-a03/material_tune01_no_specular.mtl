$SUBMATERIAL a03_hall_bay
$TEXTURE_MTL 0 hall_bay_diffuse.dds
$TEXTURE_MTL 1 hall_bay_specular.dds
$TEXTURE_MTL 2 flat_normal.dds
$DIFFUSECOLOR 1.000000 1.000000 1.000000 1.000000
$SPECULARCOLOR 0.000000 0.000000 0.000000 1.000000
$AMBIENTCOLOR 1.000000 1.000000 1.000000 1.000000
$SPECULARPOWER 2.000000

$SUBMATERIAL a03_transformer
$TEXTURE_MTL 0 transformer_diffuse.dds
$TEXTURE_MTL 1 transformer_specular.dds
$TEXTURE_MTL 2 flat_normal.dds
$DIFFUSECOLOR 1.000000 1.000000 1.000000 1.000000
$SPECULARCOLOR 0.000000 0.000000 0.000000 1.000000
$AMBIENTCOLOR 1.000000 1.000000 1.000000 1.000000
$SPECULARPOWER 2.000000

$SUBMATERIAL a03_switching_group
$TEXTURE_MTL 0 switching_group_diffuse.dds
$TEXTURE_MTL 1 switching_group_specular.dds
$TEXTURE_MTL 2 flat_normal.dds
$DIFFUSECOLOR 1.000000 1.000000 1.000000 1.000000
$SPECULARCOLOR 0.000000 0.000000 0.000000 1.000000
$AMBIENTCOLOR 1.000000 1.000000 1.000000 1.000000
$SPECULARPOWER 2.000000

$END
